# VCS & CI
.git
.gitignore
.github

# Node / frontend build artifacts — installed & built fresh inside the image.
# Critical: never copy host node_modules into the build, or macOS-native
# esbuild/rollup binaries clobber the container's Linux ones and the build fails.
**/node_modules
**/dist
frontend/.env
frontend/.env.local

# Python envs & caches
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Secrets & local runtime
.env
*.db
claims.db

# Tests, docs, tooling (not needed in the image)
tests
docs
.dual-graph
.claude
CONTEXT.md

# OS / editor cruft
.DS_Store
*.log
