# Copy to .env and fill in values. .env is gitignored.
LLM_PROVIDER=mock          # "mock" (no key, default), "groq", or "gemini"
GROQ_API_KEY=              # Required when LLM_PROVIDER=groq
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   # Groq vision model
GEMINI_API_KEY=            # Required when LLM_PROVIDER=gemini
DB_PATH=claims.db          # SQLite path (default: project root)
POLICY_PATH=data/policy_terms.json
TEST_CASES_PATH=data/test_cases.json
API_BASE_URL=http://localhost:8000   # Used by the Streamlit UI
