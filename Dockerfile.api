FROM python:3.13-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code and data
COPY app/ app/
COPY data/ data/
# Per-case document images for the live (vision) eval path. Without these the
# /eval/run/{case_id} endpoint cannot exercise real LLM extraction.
COPY eval_docs/ eval_docs/
COPY .env.example .env.example

# Non-root user for security
RUN adduser --disabled-password --gecos "" appuser && chown -R appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1 \
    LLM_PROVIDER=mock \
    DB_PATH=/tmp/claims.db \
    POLICY_PATH=data/policy_terms.json \
    TEST_CASES_PATH=data/test_cases.json \
    LOG_LEVEL=INFO

EXPOSE 8000

CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
